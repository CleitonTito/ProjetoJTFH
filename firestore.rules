rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow read, update, delete: if request.auth != null
        && getUserData().role == 'admin'
        && getUserData().organizationId == resource.data.organizationId;
      allow create: if request.auth != null
        && getUserData().role == 'admin'
        && getUserData().organizationId == request.resource.data.organizationId;
    }

    match /organizations/{orgId} {
      allow read: if request.auth != null && getUserData().organizationId == orgId;
    }

    match /categories/{categoryId} {
      allow read: if request.auth != null
        && getUserData().organizationId == resource.data.organizationId;
      allow create: if request.auth != null
        && getUserData().role == 'admin'
        && getUserData().organizationId == request.resource.data.organizationId;
      allow update, delete: if request.auth != null
        && getUserData().role == 'admin'
        && getUserData().organizationId == resource.data.organizationId;
    }

    match /publications/{publicationId} {
      allow read: if request.auth != null
        && getUserData().organizationId == resource.data.organizationId;
      allow create: if request.auth != null
        && (getUserData().role == 'admin' || getUserData().role == 'editor')
        && getUserData().organizationId == request.resource.data.organizationId;
      allow update, delete: if request.auth != null
        && (getUserData().role == 'admin' || getUserData().role == 'editor')
        && getUserData().organizationId == resource.data.organizationId;
    }
  }
}
